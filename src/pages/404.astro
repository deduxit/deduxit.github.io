---
// deduxit © Fabian Lukas Grubmüller 2026
// Licensed under the EUPL

// The page GitHub Pages serves for any path of the site that holds no file:
// built to /404.html, and served at the missing path itself, so every link
// on it is absolute. deduxit's documentation at /deduxit/ is a site of its own
// on the same address and never reaches this page.
import Base from "../layouts/Base.astro";
// The word mark inline, so that the theme's tokens paint it (app.css's `.logo`).
import wordmark from "../logo/wordmark-band.svg?raw";
---

<Base title="Not found: deduxit" description="No page of deduxit's site is at this address.">
  <main class="page">
    <a class="logo large" href="/"><Fragment set:html={wordmark} /></a>
    <h1>Not found</h1>
    <p>No page of this site is at this address.</p>
    <ul>
      <li><a href="/">The prover</a>: type a sequent of linear logic and prove it.</li>
      <li><a href="/deduxit/">deduxit's documentation</a>, the library's API.</li>
      <li><a href="https://github.com/deduxit/deduxit">deduxit on GitHub</a>.</li>
      <li><a href="/privacy/">Privacy</a>: what the site keeps of you, and what GitHub logs.</li>
    </ul>
  </main>
</Base>
