// The one page: the prover, one Solid island rendered in the browser alone,
// since everything on it is the prover's and runs on deduxit's module there.
// Without a script the page says what it is. deduxit's math fonts, Euler
// Math, which the island loads for its drawings and exports, and the four
// others an export may be set in, are imported here, so that they are built
// as the other fonts are, under /fonts/ (astro.config.ts).
//
// The written content (src/content.config.ts) the island shows (About and the tour's captions)
// is rendered here into inert templates, each marked data-written, which the island clones; the
// ordinary suite's examples, the tour's stops and the rules go to the island as props. Learn's
// and Practice's content stays in src/content/ until they come back.
import asana from "deduxit-fonts/Asana-Math.otf?url";
import euler from "deduxit-fonts/Euler-Math.otf?url";
import garamond from "deduxit-fonts/Garamond-Math.otf?url";
import newcm from "deduxit-fonts/NewCMMath-Book.otf?url";
import stix from "deduxit-fonts/STIXTwoMath-Regular.otf?url";
import { getCollection, render } from "astro:content";
import App from "../islands/App";
import examplesFile from "../content/examples.json";
import type { Rule, Sample, Stop } from "../lib/content";
import Base from "../layouts/Base.astro";

const stops = (await getCollection("tour")).sort((a, b) => a.id.localeCompare(b.id));
// The file's order is the menu's, a lesson's order; the collection is sorted by id.
const order = examplesFile.map((e) => e.id);
const samples: Sample[] = (await getCollection("examples"))
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id))
  .map((e) => ({
  id: e.id,
  title: e.data.title,
  sequent: e.data.sequent,
  logic: e.data.logic,
  note: e.data.note,
}));
const texts = await getCollection("texts");
const rules = (await getCollection("rules")).sort((a, b) => a.id.localeCompare(b.id));

const stopData: Stop[] = stops.map((s) => ({
  id: s.id,
  title: s.data.title,
  target: s.data.target,
  act: s.data.act,
}));
const ruleData: Rule[] = rules.map((r) => ({ id: r.id, ...r.data }));

const rendered = await Promise.all(
  [...stops, ...texts].map(async (entry) => ({
    key: `${entry.collection}/${entry.id}`,
    Content: (await render(entry)).Content,
  })),
);
---

<Base title="deduxit" description="Prove sequents of linear logic, and of ordinary logic in LK and LJ, step by step, in the browser.">
  <main>
    <h1 class="sr-only">deduxit: linear and ordinary logic, proved in the browser</h1>
    <App
      client:only="solid-js"
      fonts={{ euler, "stix-two": stix, garamond, asana, "new-computer-modern": newcm }}
      samples={samples}
      stops={stopData}
      rules={ruleData}
    >
      <p slot="fallback" class="noscript">
        deduxit proves sequents of linear and ordinary logic in the browser; the page needs
        JavaScript and WebAssembly.
      </p>
    </App>
    {
      rendered.map(({ key, Content }) => (
        <template data-written data-content={key}>
          <Content />
        </template>
      ))
    }
    <template data-written data-content="licence">
      <p class="licence">
        The text of this page is © Fabian Lukas Grubmüller 2026, licensed under
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.
      </p>
    </template>
  </main>
</Base>
