{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "result", "node_modules", ".cache/node-modules"],
  "compilerOptions": {
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "deduxit-web/*": ["./.cache/deduxit-web/*"],
      "deduxit-fonts/*": ["./.cache/deduxit-fonts/*"]
    }
  }
}
