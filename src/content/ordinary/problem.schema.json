{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "sequent": {
      "type": "string"
    },
    "logic": {
      "type": "string",
      "enum": [
        "classical",
        "intuitionistic",
        "minimal"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "valid",
        "not_valid"
      ]
    },
    "level": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "conjunction",
          "disjunction",
          "equivalence",
          "implication",
          "negation",
          "constants",
          "classical",
          "intuitionistic",
          "minimal",
          "literature"
        ]
      }
    },
    "lesson": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "sequent",
    "logic",
    "verdict",
    "level",
    "categories"
  ]
}
