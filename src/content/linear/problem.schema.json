{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "sequent": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "classical",
        "affine",
        "mix",
        "affine-mix",
        "intuitionistic",
        "intuitionistic-affine"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "provable",
        "unprovable"
      ]
    },
    "level": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "multiplicatives",
          "additives",
          "units",
          "exponentials",
          "quantifiers",
          "classical",
          "intuitionistic",
          "structural",
          "literature"
        ]
      }
    },
    "fragment": {
      "type": "string"
    },
    "lesson": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "sequent",
    "mode",
    "verdict",
    "level",
    "categories",
    "fragment"
  ]
}
