{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lesson": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "worked": {
      "type": "string"
    },
    "choices": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["rule", "reason"]
      }
    },
    "faded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "explain": {
      "type": "object",
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["after", "prompt", "answer"]
    },
    "hinge": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "problem": {
                "type": "string"
              },
              "misconception": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["text", "why"]
          }
        }
      },
      "required": ["question", "options"]
    },
    "method": {
      "type": "string",
      "enum": ["sequent", "natural", "tableau", "table"]
    },
    "logic": {
      "type": "string",
      "enum": ["classical", "intuitionistic", "minimal"]
    },
    "layout": {
      "type": "string",
      "enum": ["tree", "fitch"]
    },
    "model": {
      "type": "string"
    }
  },
  "required": [
    "lesson",
    "title",
    "worked",
    "choices",
    "steps",
    "faded",
    "explain",
    "hinge",
    "method",
    "logic"
  ]
}
